"use strict";
var mainImage = document.querySelector("#largeImg");
var thumbs = document.getElementById("thumbs");
thumbs.addEventListener("click", function(e) {
    e.preventDefault();
    var target = e.target;
    if (target.tagName === "IMG") target = target.parentElement;
    if (target.tagName === "A") mainImage.src = target.href;
});

